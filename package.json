{
  "name": "kickpulse-football-ai-hub",
  "version": "1.11.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components/AppProviders.jsx components/football components/layout lib scripts tests --ignore-pattern .next",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run build",
    "ai:import": "node --env-file-if-exists=.env.local scripts/football-ai/import-football-data.mjs",
    "ai:import:dry": "node --env-file-if-exists=.env.local scripts/football-ai/import-football-data.mjs --dry-run",
    "ai:enrich": "node --env-file-if-exists=.env.local scripts/football-ai/import-thestatsapi.mjs",
    "ai:enrich:sample": "node --env-file-if-exists=.env.local scripts/football-ai/import-thestatsapi.mjs --limit=25 --resources=stats,odds",
    "ai:leagues:coverage": "node --env-file-if-exists=.env.local scripts/football-ai/check-thestatsapi-coverage.mjs --leagues=E1,B1,SC0",
    "ai:leagues:import:dry": "node --env-file-if-exists=.env.local scripts/football-ai/import-football-data.mjs --dry-run --leagues=E1,B1,SC0",
    "ai:leagues:import": "node --env-file-if-exists=.env.local scripts/football-ai/import-football-data.mjs --leagues=E1,B1,SC0",
    "ai:leagues:enrich:sample": "npm run ai:enrich:sample -- --seasons=2024 --leagues=E1 && npm run ai:enrich:sample -- --seasons=2024 --leagues=B1 && npm run ai:enrich:sample -- --seasons=2024 --leagues=SC0",
    "ai:leagues:enrich": "node --env-file-if-exists=.env.local scripts/football-ai/import-thestatsapi.mjs --leagues=E1,B1,SC0 --resources=stats,odds",
    "ai:leagues:train:candidate": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=domestic-expansion --persist-features --promotion=never",
    "ai:train": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=elo-poisson-global",
    "ai:train:big-five": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=elo-poisson-global",
    "ai:train:big-five:candidate": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=elo-poisson-global --persist-features --promotion=never",
    "ai:train:big-five:gated": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=elo-poisson-global --persist-features --min-new-matches=30 --promotion=auto",
    "ai:train:expansion": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=domestic-expansion --persist-features",
    "ai:train:expansion:candidate": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=domestic-expansion --persist-features --promotion=never",
    "ai:train:expansion:gated": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=domestic-expansion --persist-features --min-new-matches=30 --promotion=auto",
    "ai:train:features": "node --env-file-if-exists=.env.local scripts/football-ai/train-baseline.mjs --model-key=elo-poisson-global --persist-features",
    "ai:train:gated": "npm run ai:train:big-five:gated && npm run ai:train:expansion:gated",
    "ai:model:activate": "node --env-file-if-exists=.env.local scripts/football-ai/activate-model.mjs",
    "ai:ucl:import:dry": "node --env-file-if-exists=.env.local scripts/football-ai/import-ucl-history.mjs --dry-run",
    "ai:ucl:import": "node --env-file-if-exists=.env.local scripts/football-ai/import-ucl-history.mjs",
    "ai:ucl:enrich:sample": "node --env-file-if-exists=.env.local scripts/football-ai/import-thestatsapi.mjs --limit=25 --leagues=CL --resources=stats,odds",
    "ai:ucl:enrich": "node --env-file-if-exists=.env.local scripts/football-ai/import-thestatsapi.mjs --leagues=CL --resources=stats,odds",
    "ai:ucl:archive": "node --env-file-if-exists=.env.local scripts/football-ai/import-thestatsapi.mjs --leagues=CL --resources=player-stats,lineups,shotmap,timeline,referee",
    "ai:ucl:train": "node --env-file-if-exists=.env.local scripts/football-ai/train-ucl.mjs",
    "ai:fixtures:dry": "node --env-file-if-exists=.env.local scripts/football-ai/sync-upcoming.mjs --dry-run",
    "ai:fixtures:sync": "node --env-file-if-exists=.env.local scripts/football-ai/sync-upcoming.mjs",
    "ai:fixtures:settle": "node --env-file-if-exists=.env.local scripts/football-ai/settle-predictions.mjs",
    "ai:results:refresh": "node --env-file-if-exists=.env.local scripts/football-ai/refresh-current-results.mjs",
    "ai:fixtures:update": "npm run ai:fixtures:settle && npm run ai:fixtures:sync",
    "ai:learn:daily": "npm run ai:fixtures:settle && npm run ai:results:refresh && npm run ai:fixtures:sync",
    "ai:learn:weekly": "npm run ai:fixtures:update && npm run ai:train:gated",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve api-football-sync --no-verify-jwt"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1"
  },
  "type": "module",
  "displayName": "KickPulse Football AI Hub"
}
